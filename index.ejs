<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Deslizar</title><link rel="stylesheet" href="/style.css"></head><body><main class="app"><%- include('sidebar', {matches}) %><section class="swipe-area"><a class="logout" href="/logout">🚪 Salir</a><% if(profile){ %><article class="profile-card"><img src="<%= profile.photo %>" alt="<%= profile.name %>"><div class="profile-info"><h2><%= profile.name %>, <%= profile.age %></h2><p><%= profile.bio %></p><div class="actions"><form method="POST" action="/skip/<%= profile._id %>"><button class="no">✕</button></form><form method="POST" action="/like/<%= profile._id %>"><button class="yes">♥</button></form></div></div></article><% } else { %><div class="no-more"><h2>No hay más perfiles por ahora 😅</h2><p>Ya viste los 90 perfiles generados.</p></div><% } %><button class="bot-btn" onclick="toggleBot()">🤖</button><div id="bot" class="bot hidden"><div class="bot-head">Gemini AI <button onclick="toggleBot()">×</button><small>Dev por Dr. Gamas</small></div><button class="maps" onclick="openMaps('Sushi en Veracruz')">📍 Buscar Sushi en Veracruz</button><div id="botMessages" class="bot-body"><p class="bot-msg">¡Hola! Soy Gemini. ¿En qué te ayudo hoy con tus matches?</p></div><form class="bot-form" onsubmit="askBot(event)"><input id="botInput" placeholder="Pregunta algo..."><button>➤</button></form></div></section></main><script src="/app.js"></script></body></html>
