<aside class="sidebar"><h2>🔥 Tus Matches</h2><input class="search" placeholder="🔍 Buscar un chat..."><% if(matches && matches.length){ %><div class="match-list"><% matches.forEach(m=>{ %><a class="match-item" href="/chat/<%= m._id %>"><img src="<%= m.photo %>"><div><b><%= m.name %></b><span><%= m.bio.substring(0,32) %>...</span></div></a><% }) %></div><% } else { %><p class="empty">Aún no tienes matches.<br>Sigue deslizando.</p><% } %></aside>
