<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Chat</title><link rel="stylesheet" href="/style.css"></head><body><main class="app"><%- include('sidebar', {matches}) %><section class="chat"><header><a href="/">← Volver a Deslizar</a><img src="<%= profile.photo %>"><div><h3><%= profile.name %></h3><p><%= profile.bio %></p></div><button onclick="openMaps('lugares para cita en <%= profile.city %>')">📍 Buscar lugar para la cita</button></header><div id="messages" class="messages"><div class="bubble ai">¡Qué onda! Vi tu perfil y suena buen plan. ¿Qué cuentas? 😄</div></div><form class="send" onsubmit="sendChat(event, '<%= profile._id %>')"><input id="chatInput" placeholder="Escribe un mensaje..."><button>Enviar</button></form></section></main><script src="/app.js"></script></body></html>
